# Copier en .env et adapter.
DATABASE_URL=postgresql+psycopg://UTILISATEUR:MOT_DE_PASSE@HOTE:5432/ciat_vision
# Chaîne aléatoire d'au moins 32 caractères : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
# Facultatif : active la rédaction des réponses par l'IA (sinon mode dégradé)
ANTHROPIC_API_KEY=
# Production : mettre à false après avoir créé de vrais comptes / importé les vraies données
CREATE_DEMO_ACCOUNTS=true
SEED_SIMULATED_DATA=true
